    created_at,
    updated_at,
    deleted_at
FROM expenses
WHERE family_id = :family_id AND type = 'RECURRING' AND deleted_at IS NULL
ORDER BY due_date, created_at;

selectInstallmentPlansByFamily:
SELECT
    plans.id AS plan_id,
    plans.family_id AS plan_family_id,
    plans.description AS plan_description,
    plans.total_amount_in_cents AS plan_total_amount_in_cents,
    plans.installment_count AS plan_installment_count,
    plans.first_due_date AS plan_first_due_date,
    plans.category_id AS plan_category_id,
    plans.account_id AS plan_account_id,
    plans.created_by AS plan_created_by,
    plans.created_at AS plan_created_at,
    plans.updated_at AS plan_updated_at,
    positions.id AS installment_id,
    positions.number AS installment_number,
    positions.total_installments AS installment_total,
    positions.created_at AS installment_created_at,
    positions.updated_at AS installment_updated_at,
    expenses.id AS expense_id,
    expenses.family_id AS expense_family_id,
    expenses.category_id AS expense_category_id,
    expenses.account_id AS expense_account_id,
    expenses.description AS expense_description,
    expenses.amount_in_cents AS expense_amount_in_cents,
    expenses.due_date AS expense_due_date,
    expenses.type AS expense_type,
    expenses.status AS expense_status,
    expenses.notes AS expense_notes,
    expenses.recurrence_id AS expense_recurrence_id,
    expenses.created_by AS expense_created_by,
    expenses.updated_by AS expense_updated_by,
    expenses.created_at AS expense_created_at,
    expenses.updated_at AS expense_updated_at,
    expenses.deleted_at AS expense_deleted_at
FROM installment_plans AS plans
JOIN installments AS positions ON positions.installment_plan_id = plans.id
JOIN expenses ON expenses.id = positions.expense_id
WHERE plans.family_id = :family_id
  AND expenses.family_id = plans.family_id
  AND expenses.type = 'INSTALLMENT'
  AND expenses.deleted_at IS NULL
ORDER BY plans.created_at DESC, plans.id, positions.number;

countInstallmentPlansByFamily:
SELECT COUNT(*) FROM installment_plans WHERE family_id = :family_id;

selectFamilyExists:
SELECT EXISTS(SELECT 1 FROM families WHERE id = :family_id);

selectUserExists:
SELECT EXISTS(SELECT 1 FROM users WHERE id = :user_id);

selectOwnerFamily:
SELECT
    users.id AS user_id,
    families.id AS family_id,
    users.name AS owner_name,
    families.name AS family_name
FROM family_members
INNER JOIN users ON users.id = family_members.user_id
INNER JOIN families ON families.id = family_members.family_id
WHERE family_members.role = 'OWNER'
ORDER BY family_members.created_at ASC
LIMIT 1;

selectCategoriesByFamily:
SELECT id, family_id, name, icon, is_active, created_at, updated_at
FROM categories
WHERE family_id = :family_id
ORDER BY name ASC;

selectCategoryByName:
SELECT id, family_id, name, icon, is_active, created_at, updated_at
FROM categories
WHERE family_id = :family_id AND name = :name
LIMIT 1;

insertCategory:
INSERT OR IGNORE INTO categories(
    id,
    family_id,
    name,
    icon,
    is_active,
    created_at,
    updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?);

deactivateCategory:
UPDATE categories
SET is_active = 0, updated_at = :updated_at
WHERE family_id = :family_id AND id = :id AND is_active = 1;

selectCategoryInactive:
SELECT EXISTS(
    SELECT 1 FROM categories
    WHERE family_id = :family_id AND id = :id AND is_active = 0
);

selectAccountsByFamily:
SELECT id, family_id, name, type, institution_name, is_active, created_at, updated_at
FROM accounts
WHERE family_id = :family_id
ORDER BY name ASC;

