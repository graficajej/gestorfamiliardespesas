insertGeneratedRecurrenceExpense:
INSERT OR IGNORE INTO expenses(
    id,
    family_id,
    category_id,
    account_id,
    description,
    amount_in_cents,
    currency,
    due_date,
    type,
    status,
    notes,
    recurrence_id,
    created_by,
    updated_by,
    created_at,
    updated_at,
    deleted_at
)
SELECT
    :id,
    recurrences.family_id,
    recurrences.category_id,
    recurrences.account_id,
    recurrences.description,
    recurrences.amount_in_cents,
    'BRL',
    :due_date,
    'RECURRING',
    :status,
    NULL,
    recurrences.id,
    recurrences.created_by,
    recurrences.created_by,
    :created_at,
    :updated_at,
    NULL
FROM recurrences
WHERE recurrences.id = :recurrence_id
  AND recurrences.family_id = :family_id
  AND recurrences.is_active = 1;

selectRecurrenceOccurrenceExists:
SELECT EXISTS(
    SELECT 1 FROM expenses
    WHERE recurrence_id = :recurrence_id AND due_date = :due_date
      AND type = 'RECURRING' AND deleted_at IS NULL
);

selectRecurrenceExpensesByFamily:
SELECT
    id,
    family_id,
    category_id,
    account_id,
    description,
    amount_in_cents,
    due_date,
    type,
    status,
    notes,
    recurrence_id,
    created_by,
