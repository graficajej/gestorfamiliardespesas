    :family_id,
    :description,
    :amount_in_cents,
    'BRL',
    :category_id,
    :account_id,
    :frequency,
    :start_date,
    :due_day,
    1,
    :created_by,
    :created_at,
    :updated_at
);

updateActiveRecurrence:
UPDATE recurrences
SET description = :description,
    amount_in_cents = :amount_in_cents,
    category_id = :category_id,
    account_id = :account_id,
    frequency = :frequency,
    start_date = :start_date,
    due_day = :due_day,
    updated_at = :updated_at
WHERE family_id = :family_id AND id = :id AND is_active = 1;

cancelActiveRecurrence:
UPDATE recurrences
SET is_active = 0, updated_at = :updated_at
WHERE family_id = :family_id AND id = :id AND is_active = 1;

selectRecurrencesByFamily:
