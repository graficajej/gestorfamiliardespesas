    family_id,
    description,
    amount_in_cents,
    category_id,
    account_id,
    frequency,
    start_date,
    due_day,
    is_active,
    created_by,
    created_at,
    updated_at
FROM recurrences
WHERE family_id = :family_id
ORDER BY is_active DESC, created_at DESC;

